# Copy this file to `.env` and adjust if needed:  cp .env.example .env
#
# Local development database — a plain PostgreSQL instance on localhost:5432.
# One-time setup (run as the `postgres` superuser):
#   CREATE USER warehouse WITH PASSWORD 'warehouse' CREATEDB;
#   CREATE DATABASE warehouse OWNER warehouse;
DATABASE_URL="postgresql://warehouse:warehouse@localhost:5432/warehouse?schema=public"
